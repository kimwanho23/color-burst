{
  "name": "color-burst",
  "version": "1.0.0-beta.7",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "typecheck": "tsc -p server --noEmit && tsc -p client --noEmit",
    "test": "node --import tsx --test \"shared/test/**/*.test.ts\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
